# Public/frontend-safe values only. Copy to .env.local for local development.
# Never commit direct database URLs, passwords, service-role keys, or private provider tokens.

SUPABASE_URL=https://lumllkbsiuxoohdolrtm.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Optional Google Sheets bridge: publish a Sheet tab as CSV, then paste the CSV URL here.
RACETRACKER_EVENT_SHEET_CSV_URL=
RACETRACKER_EVENT_SHEET_OUTPUT=raceTracker/assets/data/event-schedule.json

# Race-weather alerts. Slack or Discord incoming webhook, used only by
# scripts/build_weather_forecast.py --notify. In CI this comes from the GitHub
# Actions secret of the same name — never commit a real webhook URL.
# The default forecast provider (Open-Meteo) needs no API key at all.
RACETRACKER_WEATHER_WEBHOOK_URL=
